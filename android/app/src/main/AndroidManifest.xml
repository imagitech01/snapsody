<?xml version="1.0" encoding="utf-8"?>
<!--
  Snapsody (openspec practice-app, task 10.1). Fully offline: no INTERNET permission, ever
  (score-recognition "No data leaves the phone"). Capacitor's template declares it and ML Kit
  merges it in (for Google's usage logging); both are removed here. The app still loads from
  Capacitor's local origin https://localhost. ACCESS_NETWORK_STATE, also merged in, grants no
  network access and is left alone.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!--
      ML Kit's document scanner merges in an activity locked to portrait
      (GmsDocumentScanningDelegateActivity), which makes Play treat android.hardware.screen.portrait
      as required and hide the app from devices without it. Snapsody works in both orientations
      (app-shell "Practice in portrait and landscape"), so the feature is optional.
    -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <!-- The Reader's foreground service (design D6): one service for a whole reading job. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          mediaProcessing: 6 hours per 24 h, enough for a queue of pages on the CPU. shortService
          (3 minutes for the whole job) was too short in the spike (evidence/spike.md, 1.3).
        -->
        <service
            android:name=".reader.ReaderService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
