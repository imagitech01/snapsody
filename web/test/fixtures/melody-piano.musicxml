<?xml version='1.0' encoding='utf-8'?>
<!--
  Melody and piano, in the form homr 0.7.1 writes a melody-and-piano page: part P1 "Voice" (one staff) and part
  P2 "Piano" (two staves, <staves>2, voices 1 on staff 1 and 5-6 on staff 2, <backup> between staves and voices,
  <forward> for a gap, <chord/>, a whole-bar rest on a staff that is hidden in a system).
  The music is ORIGINAL, written for the tests of the parts-and-accompaniment change. It is not from any book.
  Contents: 8 bars of 4/4 in C, bars 1-4 repeated; a slur in the melody (bar 6), a fermata in the melody only
  (bar 3, beat 3), chords in the right hand, two voices in the left hand (bar 3), a melody rest (bar 5), a
  hidden left-hand staff (bar 6).
-->
<score-partwise version="4.0"><work><work-title>Melody and piano study</work-title></work><identification><encoding><software>homr</software></encoding></identification><defaults /><part-list><score-part id="P1"><part-name>Voice</part-name><score-instrument id="P1-I1"><instrument-name>Voice</instrument-name><instrument-sound>voice</instrument-sound></score-instrument><midi-instrument id="P1-I1"><midi-channel>1</midi-channel><midi-program>54</midi-program><volume>100</volume><pan>0</pan></midi-instrument></score-part><score-part id="P2"><part-name>Piano</part-name><score-instrument id="P2-I1"><instrument-name>Piano</instrument-name><instrument-sound>keyboard.piano</instrument-sound></score-instrument><midi-instrument id="P2-I1"><midi-channel>2</midi-channel><midi-program>1</midi-program><volume>100</volume><pan>0</pan></midi-instrument></score-part></part-list>
